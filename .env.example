# Copy to .env (local) or set in the Vercel dashboard (Settings → Environment Variables).
GEMINI_API_KEY=
# Optional: more keys, comma separated. Tried in turn when one is out of quota. Keys from the
# same Google project share one quota, so only keys from different projects add capacity.
# GEMINI_API_KEYS=
# Optional: models, tried in order when one is overloaded or out of quota.
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
